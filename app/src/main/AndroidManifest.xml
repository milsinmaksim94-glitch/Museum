<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- интернет нужен для общей базы Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MuseumApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Museum">

        <!-- экран входа открывается первым -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:label="@string/title_login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RegisterActivity"
            android:label="@string/title_register" />

        <activity
            android:name=".ui.MainActivity"
            android:label="@string/app_name" />

        <activity
            android:name=".ui.ExhibitDetailActivity"
            android:label="@string/title_exhibit"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.BookingActivity"
            android:label="@string/title_booking"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.MyBookingsActivity"
            android:label="@string/title_my_bookings"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.FavoritesActivity"
            android:label="@string/title_favorites"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AdminActivity"
            android:label="@string/title_admin"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.ExhibitEditActivity"
            android:label="@string/title_exhibit_edit"
            android:parentActivityName=".ui.AdminActivity" />

        <activity
            android:name=".ui.GuideActivity"
            android:label="@string/title_guide"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.PlaceActivity"
            android:label="@string/title_place"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AboutActivity"
            android:label="@string/title_about"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.GuideEditActivity"
            android:label="@string/title_guide_edit"
            android:parentActivityName=".ui.AdminActivity" />

        <activity
            android:name=".ui.PlaceEditActivity"
            android:label="@string/title_place_edit"
            android:parentActivityName=".ui.AdminActivity" />

    </application>

</manifest>
